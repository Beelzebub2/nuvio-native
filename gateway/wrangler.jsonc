{
  "name": "nuvio-native-gateway",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "keep_vars": true,
  "send_metrics": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
